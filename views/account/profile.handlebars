<div class="container">
  <script src="/public/js/account-validation.js"></script>
    <h1>Profile</h1>
    
  {{#if user}}
   
  <form action="/account/profile" method="POST">
    <div class="flex-col mb">
      <label for="txtUsername">Username:</label>
      <span id="username-check"></span>
      <input type="text" name="username" id="txtUsername" value="{{user.username}}"  data-original-username="{{user.username}}">
    </div>

    <div class="flex-col mb">
      <label for="txtPassword1">Password:</label>
      <input type="password" name="password1" id="txtPassword1" value="">
    </div>

    <div class="flex-col mb">
      <label for="txtPassword2">Confirm Password:</label>
      <span id="password-match"></span>
      <input type="password" name="password2" id="txtPassword2">
    </div>

    <div class="flex-col mb">
      <label for="txtName">Name:</label>
      <input type="text" name="name" id="txtName" value="{{user.name}}">
    </div>

    <div class="flex-col mb">
      <label for="txtDob">Date of birth:</label>
      <input type="date" name="dob" id="txtDob" value="{{user.dob}}">
    </div>
    <div class="flex-col mb">    
    <fieldset class="avatar-picker">
    <legend>Choose an avatar:</legend>
    <!-- This avatar style is a remix of: Croodles - Doodle your face by vijay verma, licensed under CC BY 4.0 -->
    <label class="avatar-option">
      <img
        src="https://api.dicebear.com/9.x/croodles/svg?seed=AB&size=80&radius=50"
        alt="Avatar AB"
        width="80"
        height="80"
      >
      <input
        type="radio"
        name="avatar"
        value="https://api.dicebear.com/9.x/croodles/svg?seed=AB&radius=50"
        required
      >
    </label>

    <label class="avatar-option">
      <img
        src="https://api.dicebear.com/9.x/croodles/svg?seed=CD&size=80&radius=50"
        alt="Avatar CD"
        width="80"
        height="80"
      >
      <input
        type="radio"
        name="avatar"
        value="https://api.dicebear.com/9.x/croodles/svg?seed=CD&radius=50"
      >
    </label>

    <label class="avatar-option">
      <img
        src="https://api.dicebear.com/9.x/croodles/svg?seed=EF&size=80&radius=50"
        alt="Avatar EF"
        width="80"
        height="80"
      >
      <input
        type="radio"
        name="avatar"
        value="https://api.dicebear.com/9.x/croodles/svg?seed=EF&radius=50"
      >
    </label>
  </fieldset>
    </div>
    <div class="flex-col mb"> 
      <label for="txtDescription">Description:</label>
        <textarea name="description" id="txtDescription" maxlength="400">{{user.description}}</textarea>
    </div>
    <div class="flex-row justify-sb align-center">
      <button type="submit" id="submitBtn">Update account</button>
    </div>
  </form>
    <form action="/account/delete" method="POST" onsubmit="return confirm('This will permanently delete your account. Continue?');">
        <div class="flex-row justify-sb align-center">
         <button type="submit">Delete my account</button>
        </div>
    </form>
    {{/if}}

</div>