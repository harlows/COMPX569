
<!-- Include the Quill library -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/public/js/quill-editor.js"></script>

<div class="container">
    <h1>Edit Article</h1>

    <form class="quill-form" action="/articles/{{article.id}}/edit" method="POST" enctype="multipart/form-data">
        <div class="flex-col mb">
            <label for="articleTitle">Title:</label>
            <input type="text" name="title" id="articleTitle" value="{{article.title}}" required>
        </div>
        <div class="flex-col mb">
            <label for="content">Content:</label>
            <!-- Create the editor container -->
            <div class="quill-editor">
              {{{article.content}}}
            </div>
            <!-- Hide textarea, but still available for an Express req.body.content -->
            <textarea name="content" class="quill-content" hidden></textarea>
        </div>
    
        <!-- Display cover image (if one exists) -->
        {{#if article.image_path}}
            <img src="{{article.image_path}}" style="max-width:100%;">
        {{/if}}

        <div class="flex-col mb">
          <label for="inpFile">Upload cover image:</label>
          <input id="inpFile" type="file" name="imageFile" accept=".png,.jpg,.jpeg,.bmp,.gif">
        </div>

        <div class="flex-row justify-sb align-center">
            <button type="submit" class="btn">Republish</button>
        </div>
    </form>

    <!-- AI image generation -->
    <form action="/articles/{{article.id}}/generate-cover" method="POST">
        <button type="submit" class="btn">Generate AI cover image</button>
    </form>
    
    <!-- Delete form -->
    <form action="/delete" method="POST" onsubmit="return confirm('This will permanently delete your article. Continue?');">
        <div class="flex-row justify-sb align-center">
         <button type="submit" name="articleId" class="btn" value="{{article.id}}">Delete</button>
        </div>
    </form>
</div>