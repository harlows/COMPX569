<div class="container">
  
{{#if message}}
  {{message}}
{{/if}}

  <h1>Hello, {{#if user}}{{user.name}}{{else}}welcome{{/if}}!</h1>
  <h2>Latest articles</h2>

  <table>
    {{#each allArticles}}
      <h3>{{title}} by {{author}}</h3>
      <p>{{content}}</p>
    {{/each}}
  </table>
  {{#if user}}
  <h2>Your articles</h2>
    <table>
    {{#each myArticles}}
      <h3>{{title}}</h3>
    {{/each}}
  </table>
    <p><a href="/articles/new">New Article</a></p>
    <p>Click <a href="/account/logout">here</a> to log out.</p>
    <p>Click <a href="/account/profile">here</a> to edit your profile.</p>    
  {{else}}
    <p>Click <a href="/account/login">here</a> to log in.</p>
    {{/if}}
</div>