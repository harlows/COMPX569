<div id = "container">
 
  {{#if article.likedByUser}}Liked{{else}}Like{{/if}}


    <img src="{{article.image_path}}">
    <h2>{{article.title}}</h2>
    <p>{{{article.content}}}</p>
    {{#if user}}
    <form action="/articles/{{article.id}}/like" method="POST">
        <div class="flex-col mb">
            {{user.name}}
        </div>
    </form>
    {{/if}}
</div>