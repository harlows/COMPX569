<!-- Include the Quill library -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/public/js/quill-editor2.js"></script>

{{#if message}}
  {{message}}
{{/if}}

<div class="container article">

    <div id="header" class="cover">
        <img src="{{article.image_path}}">
        <h2>{{article.title}}</h2>
        <h3>by {{article.author}}</h3>
        <h4>{{convertDate article.created_at}}</h4>
    </div>

    <div id="likes" class="likes">
        <span class="likes_count">{{like_count}} {{#if (checkIf like_count 1)}}Like{{else}}Likes{{/if}}</span>
        
        <!-- If logged in allow user to like or comment on an article -->
        {{#if user}}
        <form class="likes-form" action="/articles/{{article.id}}/like" method="POST">
            <button type="submit" class="btn btn-like">
                {{#if hasLiked}}Unlike{{else}}Like{{/if}}
            </button>
        </form>
        {{/if}} 
    </div>
    
    <div id="article-content">
        {{{article.content}}}
    </div>   

    <div id="comment-form">
        {{#if user}}
            <form class="quill-form" action="/articles/{{article.id}}/comment" method="POST">
                <label for="content">Comment:</label>
                <div class="quill-editor"></div>
                <textarea name="comment" class="quill-content" hidden></textarea>
                <button type="submit" class="btn">Post your comment</button>
            </form>
            {{#if comments}}
                <button id="toggle-comments" class="btn">Hide comments</button>
            {{/if}}
        {{/if}}
    </div>

    

<!-- Put into a hbs partial eventually? -->

<div id="comments">
    <h2>Comments</h2>
    {{#each comments}}
        <div class="comment top-level">
            <p><strong>{{username}}</strong> <small>{{date}}</small></p>
            {{{comment}}}
            {{#if ../user}}
                <div class="btn-actions">
                    <button type="button" class="btn btn-reply">Reply</button>
                    {{#if canDelete}}
                        <form action="/comments/{{id}}/delete" method="POST" onsubmit="return confirm('This will permanently delete your comment and any replies. Continue?')" class="inline-form">
                            <input type="hidden" name="article_id" value="{{article_id}}">
                            <button type="submit" class="btn">Delete</button>
                        </form>
                    {{/if}}
                </div>
                    
                <div class="reply-form hidden">
                    <form class="quill-form" action="/articles/{{article_id}}/comment" method="POST">
                        <label for="content">Reply:</label>
                        <!-- Create the editor container -->
                        <div class="quill-editor"></div>
                        <!--Hide textarea, but still available for an Express req.body.content -->
                        <textarea name="comment" class="quill-content" hidden></textarea>
                        <input type="hidden" name="parent_id" value="{{id}}">
                        <button type="submit" class="btn">Post your reply</button>
                    </form>
                </div>
            {{/if}}    
            {{#if replies.length}}
                {{#each replies}}
                    <div class="comment level-2">
                        <p><strong>{{username}}</strong> <small>{{date}}</small></p>
                        {{{comment}}}
                        {{#if ../../user}} 
                            <div class="btn-actions">
                                <button type="button" class="btn btn-reply">Reply</button>
                                {{#if canDelete}}
                                    <form action="/comments/{{id}}/delete" method="POST" onsubmit="return confirm('This will permanently delete your comment and any replies. Continue?')" class="inline-form">
                                        <input type="hidden" name="article_id" value="{{article_id}}">
                                        <button type="submit" class="btn">Delete</button>
                                    </form>
                                {{/if}}
                            </div>
                                   
                        <div class="reply-form hidden">
                            <form class="quill-form" action="/articles/{{article_id}}/comment" method="POST">
                                <label for="content">Reply:</label>
                                <!-- Create the editor container -->
                                <div class="quill-editor"></div>
                                <!--Hide textarea, but still available for an Express req.body.content -->
                                <textarea name="comment" class="quill-content" hidden></textarea>
                                <input type="hidden" name="parent_id" value="{{id}}">
                                <button type="submit" class="btn">Post your reply</button>
                            </form>
                        </div>
                        {{/if}} 
                        {{#if replies.length}}
                            {{#each replies}}
                                <div class="comment level-3">
                                    <p><strong>{{username}}</strong> <small>{{date}}</small></p>
                                    {{{comment}}}
                                    {{#if ../../canDelete}}
                                        <div class="btn-actions">
                                            <form action="/comments/{{id}}/delete" method="POST" onsubmit="return confirm('This will permanently delete your comment. Continue?')" class="inline-form">
                                                <input type="hidden" name="article_id" value="{{article_id}}">
                                                <button type="submit" class="btn">Delete</button>
                                            </form>
                                        </div>
                                    {{/if}}
                                </div>    
                            {{/each}}
                        {{/if}}
                    </div>
                {{/each}}
            {{/if}}
        </div>
    {{/each}}
</div>