<script src="/public/js/articles-sort.js"></script>

<div class="container">
  
{{#if message}}
  {{message}}
{{/if}}
<div id="header">
  <h1>Hello, {{#if user}}{{user.name}}{{else}}welcome{{/if}}!</h1>
  
    <h2>Latest articles</h2>
    <label for="sort-by">Sort by:</label>  
    <select id="sort-by" name="sort">
      <option value="date">Date</option>
      <option value="title">Title</option>
      <option value="author">Author</option>
    </select>
</div>

<div id="article-list">
      {{#each allArticles}}
      <article class="story">
        
        <h3 class="story-title"><a href="/articles/{{id}}/read">{{title}}</a>
        <h4 class="story-byline">Posted by {{author}} on {{convertDate date}}</h4>
        <p class="story-teaser">{{{teaser content 64}}}</p>
      </article>
      {{/each}}
    </div>


</div>

