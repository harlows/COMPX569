<div class="container">
    <h1>Edit Article</h1>

    <form action="/articles/{{article.id}}/edit" method="POST">
        <div class="flex-col mb">
            <label for="articleTitle">Title:</label>
            <input type="text" name="title" id="articleTitle" value="{{article.title}}" required>
        </div>
        <div class="flex-col mb">
            <label for="articleContent">Content:</label>
            <textarea name="content" id="articleContent" required>{{article.content}}</textarea>
        </div>
        <div class="flex-row justify-sb align-center">
            <button type="submit">Republish</button>
        </div>
    </form>
    </form>
    <form action="/delete" method="POST" onsubmit="return confirm('This will permanently delete your article. Continue?');">
        <div class="flex-row justify-sb align-center">
         <button type="submit" name="articleId" value="{{article.id}}">Delete</button>
        </div>
    </form>
</div>