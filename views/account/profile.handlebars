<div class="container">
    <h1>Profile</h1>
    
    {{#if user}}

  <form action="/account/edit" method="POST">
    <div class="flex-col mb">
      <label for="txtUsername">Username:</label>
      <span id="username-check"></span>
      <input type="text" name="username" id="txtUsername" value="{{user.username}}" required>
    </div>

    <div class="flex-col mb">
      <label for="txtPassword1">Password:</label>
      <input type="password" name="password1" id="txtPassword1" required>
    </div>

    <div class="flex-col mb">
      <label for="txtPassword2">Confirm Password:</label>
      <span id="password-match"></span>
      <input type="password" name="password2" id="txtPassword2" required>
    </div>

    <div class="flex-col mb">
      <label for="txtName">Name:</label>
      <input type="text" name="name" id="txtName" value="{{user.name}}" required>
    </div>

    <div class="flex-col mb">
      <label for="txtDob">Date of birth:</label>
      <input type="date" name="dob" id="txtDob" value="{{user.dob}}" required>
    </div>
    <div class="flex-col mb">    
      <fieldset>
        <legend>Choose an avatar</legend>
        <label>
          <input type="radio" name="avatar" value="bear.png" required>
        </label>
      </fieldset>
    </div>
    Description:
    <div class="flex-col mb">
      <textarea name="description" maxlength="400" value="{{user.description}}"></textarea>
    </div>

    <div class="flex-row justify-sb align-center">
      <button type="submit" id="btnSubmit" disabled>Update account</button>
    </div>
  </form>
    <form action="/account/delete" method="POST" onsubmit="return confirm('This will permanently delete your account. Continue?');">
        <div class="flex-row justify-sb align-center">
         <button type="submit">Delete my account</button>
        </div>
    </form>
    {{/if}}

</div>