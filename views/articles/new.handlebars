<!-- Include the Quill library -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/public/js/quill-editor.js"></script>

<div class="container">
    <h1>New Article</h1>

    <form action="/articles" method="POST">
        <div class="flex-col mb">
            <label for="articleTitle">Title:</label>
            <input type="text" name="title" id="articleTitle" required>
        </div>
        <div class="flex-col mb">
            <label for="articleContent">Content:</label>
            <!-- Create the editor container -->
            <div id="editor">
             
            </div>
            <!-- Hide textarea, but still available for an Express req.body.content -->
            <textarea name="content" id="articleContent" hidden></textarea>
        </div>
        <div class="flex-row justify-sb align-center">
            <button type="submit">Publish</button>
        </div>
    </form>
</div>