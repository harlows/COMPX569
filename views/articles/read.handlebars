<div id = "container">


    <img src="{{article.image_path}}">
    <h2>{{article.title}}</h2>
    <p>{{{article.content}}}</p>
    {{#if user}}
    <form action="/articles/{{article.id}}/like" method="POST">
        
            <button type="submit">
                {{#if hasLiked}}Unlike{{else}}Like{{/if}}
            </button>
        
    </form>
    {{/if}}
</div>