<div class = "container">
<div id="header">
  {{#if user}}

  <h1>{{user.name}}'s Articles</h1>
  
</div>

<div class="article-list">
  {{#if myArticles.length}}
    {{#each myArticles}}
    <article class="story">
      <h3 class="story-title"><a href="/articles/{{id}}/read">{{title}}</a></h3>
        <div class="btn-actions">
          <a href="/articles/{{id}}/edit" class="btn">Edit</a>
          <form action="/delete" method="POST" onsubmit="return confirm('This will permanently delete your article. Continue?');">
        
         <button type="submit" name="articleId" class="btn" value="{{id}}">Delete</button>
        </div>
    </article>
    {{/each}}
</div>
 {{else}}
    <h4>You have no articles. Writing an article is easy, you can do it!</h4>
    
  {{/if}} 
  {{/if}}
</div>