<div class="container">

  <h1>Hello, {{#if user}}{{user.name}}{{else}}welcome{{/if}}!</h1>
  <p>This is your homepage!</p>

  <table>
    {{#each allArticles}}
      <tr><td>{{title}}</td></tr>
      <tr><td>{{content}}</td></tr>
    {{/each}}
  </table>
  {{#if user}}
  <h2>Your articles</h2>
    <table>
    {{#each myArticles}}
      <tr><td>{{title}}</td></tr>
      <tr><td>{{content}}</td></tr>
    {{/each}}
  </table>
    <p>Click <a href="/account/logout">here</a> to log out.</p>
  {{else}}
    <p>Click <a href="/account/login">here</a> to log in.</p>
    {{/if}}
</div>