<!-- Include the Quill library -->
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script src="/public/js/quill-editor2.js"></script>

{{#if message}}
  {{message}}
{{/if}}

<div class = "container">
    <div id ="likes">
        {{like_count}} Likes
    </div>
    <div id="header">
        <img src="{{article.image_path}}">
    </div>
    <h2>{{article.title}}</h2>
    <p>{{{article.content}}}</p>

    <!-- If logged in allow user to like or comment on an article -->
    {{#if user}}
    <form name = "likeForm" action="/articles/{{article.id}}/like" method="POST">
        <button type="submit">
            {{#if hasLiked}}Unlike{{else}}Like{{/if}}
        </button>
    </form>

    <div id="comment-form">
        {{#if user}}
            <form class="quill-form" action="/articles/{{article.id}}/comment" method="POST">
                <label for="content">Comment:</label>
                <div class="quill-editor"></div>
                <textarea name="comment" class="quill-content" hidden></textarea>
                <button type="submit">Post your comment</button>
            </form>
        {{/if}}
    </div>
 
    {{/if}}

<!-- Put into a hbs partial eventually? -->
    <div id="comments">
        {{#each comments}}
        <div class="comment-body">
            <p><strong>{{username}}</strong> <small>{{date}}</small></p>
                {{{comment}}}
            {{#if ../user}}    
            {{#if canDelete}}
            <form action="/comments/{{id}}/delete" method="POST">
                    <input type="hidden" name="article_id" value="{{../article.id}}">
                    <button type="submit">Delete</button>
            </form>
            {{/if}}
            <div class="comment-reply">
                <button type="button" class="btn-reply">Reply</button>
            </div>
            <div class="reply-form hidden">
                <form class="quill-form" action="/articles/{{../article.id}}/comment" method="POST">
                    <label for="content">Reply:</label>
                    <!-- Create the editor container -->
                    <div class="quill-editor"></div>
                    <!-- Hide textarea, but still available for an Express req.body.content -->
                    <textarea name="comment" class="quill-content" hidden></textarea>
                    <input type="hidden" name="parent_id" value="{{id}}">
                    <button type="submit">Post your reply</button>
                </form>
            </div>
            {{/if}}
        {{/each}}
    </div>
</div>