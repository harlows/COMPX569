<script src="/public/js/article-sort.js"></script>

<div class="container">
  
{{#if message}}
  {{message}}
{{/if}}

  <h1>Hello, {{#if user}}{{user.name}}{{else}}welcome{{/if}}!</h1>
  <h2>Latest articles</h2>
  <button id="sort-date">Date</button>
  <button id="sort-title">Title</button>
  <button id="sort-name">Author</button>
  <div id="article-list">
    {{#each allArticles}}
    <article>
      <h3>{{title}} by {{author}}</h3>
      <p>{{content}}</p>
    </article>
    {{/each}}
  </div>
  {{#if user}}
  <h2>Your articles</h2>

    {{#each myArticles}}
    <article>
      <h3>{{title}}</h3>
    </article>
    {{/each}}

    <p><a href="/articles/new">New Article</a></p>
    <p>Click <a href="/account/logout">here</a> to log out.</p>
    <p>Click <a href="/account/profile">here</a> to edit your profile.</p>    
  {{else}}
    <p>Click <a href="/account/login">here</a> to log in.</p>
    {{/if}}
</div>

