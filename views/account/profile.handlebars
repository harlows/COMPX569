<div class="container">
    <h1>Profile</h1>
    
    {{#if user}}
    <form action="/account/delete" method="POST" onsubmit="return confirm('This will permanently delete your account. Continue?');">
        <div class="flex-row justify-sb align-center">
         <button type="submit">Delete my account</button>
        </div>
    </form>
    {{/if}}

</div>