<div id = "container">
    <div id ="likes">
        {{like_count}} Likes
    </div>
    <div id="header">
        <img src="{{article.image_path}}">
    </div>
    <h2>{{article.title}}</h2>
    <p>{{{article.content}}}</p>
    {{#if user}}
    
    <form action="/articles/{{article.id}}/like" method="POST">
        
            <button type="submit">
                {{#if hasLiked}}Unlike{{else}}Like{{/if}}
            </button>
        
    </form>
    {{/if}}
</div>