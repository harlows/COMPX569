<div class="container">
<div id="header">
  {{! Display a message if one was provided. }}
  {{#if message}}
    <p>{{message}}</p>
  {{/if}}
</div>

  <form action="/account/login" method="POST" class="form-narrow">
    <div class="flex-col mb">
      <label for="txtUsername">Username:</label>
      <input type="text" name="username" id="txtUsername" required>
    </div>

    <div class="flex-col mb">
      <label for="txtPassword">Password:</label>
      <input type="password" name="password" id="txtPassword" required>
    </div>

    <div class="flex-row justify-sb align-center form-actions">
      <button type="submit" class="btn">Log in</button>
      <a href="/account/create" class="btn">Register</a>
    </div>
  </form>

</div>
