<script src="/public/js/articles-sort.js"></script>

<div class="container">
  
{{#if message}}
  {{message}}
{{/if}}

  <h1>Hello, {{#if user}}{{user.name}}{{else}}welcome{{/if}}!</h1>
  
  <div id="articles">
    <h2>Latest articles</h2>
    <label for="sort-by">Sort by:</label>  
    <select id="sort-by" name="sort">
      <option value="date">Date</option>
      <option value="title">Title</option>
      <option value="author">Author</option>
    </select>
    <div id="article-list">
      {{#each allArticles}}
      <article>
        <h3><a href="/articles/{{id}}/read">{{title}}</a> by {{author}}</h3>
        <p>{{{content}}}</p>
      </article>
      {{/each}}
    </div>


</div>

